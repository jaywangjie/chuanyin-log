    65	def fromfd(fd, keep_fd=True):
    66	    """Create a socket from a file descriptor
    67	
    68	    socket domain (family), type and protocol are auto-detected. By default
    69	    the socket uses a dup()ed fd. The original fd can be closed.
    70	
    71	    The parameter `keep_fd` influences fd duplication. Under Python 2 the
    72	    fd is still duplicated but the input fd is closed. Under Python 3 and
    73	    with `keep_fd=True`, the new socket object uses the same fd.
    74	
    75	    :param fd: socket fd
    76	    :type fd: int
    77	    :param keep_fd: keep input fd
    78	    :type keep_fd: bool
    79	    :return: socket.socket instance
    80	    :raises OSError: for invalid socket fd
    81	    """
    82	    family = _raw_getsockopt(fd, socket.SOL_SOCKET, SO_DOMAIN)
    83	    typ = _raw_getsockopt(fd, socket.SOL_SOCKET, SO_TYPE)
    84	    proto = _raw_getsockopt(fd, socket.SOL_SOCKET, SO_PROTOCOL)
