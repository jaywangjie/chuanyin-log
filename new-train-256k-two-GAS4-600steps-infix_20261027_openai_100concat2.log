    50	def _raw_getsockopt(fd, level, optname):
    51	    """Make raw getsockopt() call for int32 optval
    52	
    53	    :param fd: socket fd
    54	    :param level: SOL_*
    55	    :param optname: SO_*
    56	    :return: value as int
